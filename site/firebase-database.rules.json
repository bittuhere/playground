{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['username', 'displayName', 'avatar', 'joined']) && (!data.exists() || newData.child('username').val() === data.child('username').val())",
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/)"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().matches(/^(blue|pink|green|orange|purple|ice|ember|aurora|cobalt|berry|lime|midnight|coral|royal|gold|nebula|cyber|lava|mono|pixel)$/)"
        },
        "about": {
          ".validate": "newData.isString() && newData.val().length <= 240"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "joined": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "publicProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['username', 'displayName', 'avatar']) && (!data.exists() || newData.child('username').val() === data.child('username').val())",
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/)"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().matches(/^(blue|pink|green|orange|purple|ice|ember|aurora|cobalt|berry|lime|midnight|coral|royal|gold|nebula|cyber|lava|mono|pixel)$/)"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === auth.uid",
        ".validate": "$username.matches(/^[a-z0-9_]{3,20}$/) && newData.val() === auth.uid"
      }
    },

    "friendRequests": {
      "$targetUid": {
        ".read": "auth != null && auth.uid === $targetUid",
        "$fromUid": {
          ".write": "auth != null && $targetUid !== $fromUid && (auth.uid === $fromUid || auth.uid === $targetUid) && (newData.val() === null || (newData.child('fromUid').val() === $fromUid && newData.child('targetUid').val() === $targetUid))",
          ".validate": "newData.hasChildren(['fromUid', 'targetUid', 'createdAt']) && newData.child('createdAt').isNumber()"
        }
      }
    },

    "pendingRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || (newData.val() === null && root.child('friendRequests').child($uid).child(auth.uid).exists()))",
        "$targetUid": {
          ".write": "auth != null && (auth.uid === $uid || (auth.uid === $targetUid && newData.val() === null && root.child('friendRequests').child(auth.uid).child($uid).exists()))",
          ".validate": "newData.hasChildren(['uid', 'username', 'displayName', 'createdAt']) && newData.child('uid').val() === $targetUid && newData.child('createdAt').isNumber()"
        }
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid) && newData.val() === true && (root.child('friendRequests').child($uid).child($friendUid).exists() || root.child('friendRequests').child($friendUid).child($uid).exists() || data.val() === true)",
          ".validate": "newData.val() === true || newData.val() === false"
        }
      }
    },

    "userConversations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$conversationId": {
          ".write": "auth != null && (auth.uid === $uid || newData.child('otherUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['otherUid', 'otherUsername', 'lastAt']) && newData.child('otherUid').isString() && newData.child('otherUsername').isString() && newData.child('lastAt').isNumber()"
        }
      }
    },

    "conversations": {
      "$conversationId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        ".write": "auth != null && ((!data.exists() && newData.child('members').child(auth.uid).val() === true) || data.child('members').child(auth.uid).val() === true)",
        "members": {
          "$uid": {
            ".validate": "newData.val() === true"
          }
        },
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['senderUid', 'text', 'createdAt']) && newData.child('senderUid').isString() && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 1000 && newData.child('createdAt').isNumber()"
          }
        }
      }
    },

    "favorites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "inventory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "settings": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "feedback": {
      "$uid": {
        ".read": false,
        ".write": "auth != null && auth.uid === $uid",
        "$entryId": {
          ".validate": "newData.hasChildren(['message', 'at']) && newData.child('message').isString() && newData.child('message').val().length > 0 && newData.child('message').val().length <= 1000 && newData.child('at').isNumber()"
        }
      }
    }
  }
}
